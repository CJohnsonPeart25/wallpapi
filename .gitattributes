# Text files are LF in the working tree as well as in the index, whatever core.autocrlf says, so a file an
# agent writes with LF never mixes with one checked out as CRLF.
* text=auto eol=lf

# Vendored release files are kept byte-identical to what their projects published: no line-ending
# conversion on checkout, so the file served is the file that was fetched (ADR 0014).
src/wallpapi/web/static/*.min.css -text
src/wallpapi/web/static/*.min.js -text
